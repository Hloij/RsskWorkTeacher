<Page x:Class="RsskWorkTeacher.Pages.pgRpWork"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RsskWorkTeacher.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      FontSize="17">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Выбор ЦК и Плана -->
        <ComboBox Margin="10" x:Name="cbCik" MaxHeight="50" SelectionChanged="cbCik_SelectionChanged">
         
        </ComboBox>
        <ComboBox Margin="10" Grid.Row="1" x:Name="cbPlan" MaxHeight="50" SelectionChanged="cbPlan_SelectionChanged">
          
        </ComboBox>

        <!-- Список РП -->
        <ListBox Margin="10" x:Name="lbSpisokRp" SelectionMode="Extended" Grid.RowSpan="2" Grid.Row="2" 
                 SelectionChanged="lbSpisokRp_SelectionChanged"/>

        <!-- ПАНЕЛЬ РЕДАКТОРА -->
        <Grid Grid.Column="1" Grid.RowSpan="3" Grid.Row="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- Основная область занимает все оставшееся место -->
            </Grid.RowDefinitions>

            <!-- Исправлено: добавлен Grid.Row="1" и убран Grid.Column="2" -->
            <TabControl Grid.Row="1">

                <!-- Вкладка 1: Титульный лист и Утверждение -->
                <TabItem Header="Титульный лист">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="#FAFAFA">
                        <StackPanel>
                            <TextBlock x:Name="tbTitle" Text="{Binding Title}"
                             FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"></TextBlock>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="tbdicipKod"
                                 Text="{Binding DisciplineKod}"
                                 FontSize="16" FontWeight="Bold" Margin="20"
                                 HorizontalAlignment="Center" />

                                <TextBlock 
                                x:Name="tbdicip"
                                Grid.Column="1"
                                FontSize="16" FontWeight="Bold"
                                Margin="20"
                                HorizontalAlignment="Center"
                                Text="{Binding DisciplineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="False" />
                            </Grid>

                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Специальность:" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="tbSpecial" Grid.Column="1" Text="{Binding Specialty}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Квалификация:" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="tbKvalificac" Grid.Column="1" Text="{Binding Qualification}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Форма обучения:" FontWeight="Bold" TextWrapping="Wrap"/>
                                <ComboBox x:Name="cbFormObuch" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding EducationForm}" IsEnabled="False">
                                    <ComboBoxItem Content="очная"/>
                                    <ComboBoxItem Content="заочная"/>
                                </ComboBox>
                            </Grid>

                            <GroupBox Header="Сведения об утверждении" Margin="0,20,0,0">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Протокол №:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                                    <TextBox x:Name="tbProtocolNumber" Text="{Binding ProtocolNumber, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5" IsReadOnly="True"/>

                                    <TextBlock Text="Дата:" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                                    <DatePicker x:Name="tbProtocolDate" SelectedDate="{Binding ProtocolDate}" Grid.Row="1" Grid.Column="1" Margin="0,5" IsEnabled="False"/>

                                    <TextBlock Text="Председатель:" Grid.Row="2" Grid.Column="0" Margin="0,5"/>
                                    <TextBox x:Name="tbProtocolPredsedatel" Text="{Binding ProtocolPredsedatel, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5" IsReadOnly="True"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Утверждено на методическом совете" Margin="0,20,0,0">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Протокол №:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                                    <TextBox x:Name="tbProtocolSovetNumber" Text="{Binding ProtocolSovetNumber, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5" IsReadOnly="True"/>

                                    <TextBlock Text="Дата:" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                                    <DatePicker x:Name="tbProtocolSovetDate" SelectedDate="{Binding ProtocolSovetDate}" Grid.Row="1" Grid.Column="1" Margin="0,5" IsEnabled="False"/>
                                </Grid>
                            </GroupBox>

                            <DataGrid x:Name="dgRazrabs" ItemsSource="{Binding Developers}" AutoGenerateColumns="False" Margin="0,20,0,0" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО разработчика" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка 2: Раздел 1 -->
                <TabItem Header="Раздел 1. Общая характеристика">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="White">
                        <StackPanel>
                            <TextBlock Text="1.1 Цель и место учебной дисциплины" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Цель дисциплины:" FontWeight="Bold"/>
                            <TextBox x:Name="tbPurpose" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,5,0,15" IsReadOnly="True"/>

                            <TextBlock x:Name="tbCompetencies" Text="{Binding CompetenciesLabel}" />

                            <TextBlock Text="1.2 Планируемые результаты освоения дисциплины" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                            <TextBlock Text="В результате освоения дисциплины обучающийся должен:" Margin="0,0,0,5"/>

                            <DataGrid x:Name="dgCompetencies" ItemsSource="{Binding Competencies}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="250" Margin="0,5" EnableRowVirtualization="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Код ОК, ПК" Width="100" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Уметь" Width="*" Binding="{Binding KnowHow, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Знать" Width="*" Binding="{Binding Knowledge, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn x:Name="dgcSkil" Header="Владеть навыками" Width="*" Binding="{Binding Skil, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка 3: Раздел 2 -->
                <TabItem Header="Раздел 2. Структура и содержание">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="White">
                        <StackPanel Margin="10" >
                            <!-- ИСПРАВЛЕНО: убраны Grid.RowDefinitions с Height="*" внутри ScrollViewer -->
                            <Expander x:Name="exModule21" DataContext="{Binding Module21}">
                                <Expander.Header>
                                    <TextBlock FontWeight="Bold" FontSize="16" Text="2.1 Трудоемкость освоения модуля"/>
                                </Expander.Header>
                                <StackPanel>
                                    <!-- Шапка -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Наименование составных частей модуля" FontSize="14" FontWeight="Bold" Margin="5"/>
                                        <TextBlock Grid.Column="1" Text="Объем в часах" FontSize="14" FontWeight="Bold" Margin="5"/>
                                        <TextBlock Grid.Column="2" Text="В т.ч. в форме практической подготовки" FontSize="14" FontWeight="Bold" Margin="5"/>
                                    </Grid>

                                    <!-- 1. Учебные занятия -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Учебные занятия" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="tbLearn1" Text="{Binding LearnTotal}" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="2" x:Name="tbLearn2" Text="{Binding LearnPractical}" FontSize="14" Margin="5"/>
                                    </Grid>

                                    <!-- 3. Курсовая работа -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Курсовая работа" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="tbKursach1" Text="{Binding CourseworkTotal}" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="2" x:Name="tbKursach2" Text="{Binding CourseworkPractical}" FontSize="14" Margin="5"/>
                                    </Grid>
                                    <!-- 2. Самостоятельная работа -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Самостоятельная работа" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="tbSalfWork" Text="{Binding SelfWorkTotal}" FontSize="14" Margin="5"/>
                                    </Grid>

                                    <!-- 3. Практика, в т.ч.: -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Практика, в т.ч.:" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="tbPract1" Text="{Binding PracticeTotal}" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="2" x:Name="tbPract2" Text="{Binding PracticePractical}" FontSize="14" Margin="5"/>
                                    </Grid>

                                    <!-- 4. учебная -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="   учебная" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="tbPractLearn1" Text="{Binding PracticeEduTotal}" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="2" x:Name="tbPractLearn2" Text="{Binding PracticeEduPractical}" FontSize="14" Margin="5"/>
                                    </Grid>

                                    <!-- 5. производственная -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="   производственная" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="tbPractProis1" Text="{Binding PracticeIndTotal}" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="2" x:Name="tbPractProis2" Text="{Binding PracticeIndPractical}" FontSize="14" Margin="5"/>
                                    </Grid>

                                    <!-- 6. Промежуточная аттестация -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Промежуточная аттестация" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="tbAttestationModule" Text="{Binding Attestation}" FontSize="14" Margin="5" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Всего" FontSize="14" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="tbTotalModule1" Text="{Binding TotalHours}" FontSize="14" Margin="5" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" x:Name="tbTotalModule2" Text="{Binding TotalPractical}" FontSize="14" Margin="5" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="exModule22">
                                <Expander.Header>
                                    <TextBlock FontWeight="Bold" FontSize="16" Text="2.2 Структура профессионального модуля"/>
                                </Expander.Header>
                                <DataGrid x:Name="dgModuleStructure"  ItemsSource="{Binding ModuleStructures}" 
      AutoGenerateColumns="False"  CanUserAddRows="True"
      CanUserDeleteRows="True"  GridLinesVisibility="All"
      HeadersVisibility="Column" HorizontalGridLinesBrush="Black"
      VerticalGridLinesBrush="Black" BorderBrush="Black"
      BorderThickness="1" FontFamily="Times New Roman" FontSize="12">

                                    <DataGrid.Resources>
                                        <!-- Стиль для заголовков, чтобы текст переносился на новую строку -->
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                            <Setter Property="BorderBrush" Value="Black"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                        <!-- Стиль для ячеек -->
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Block.TextAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="BorderBrush" Value="Black"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <!-- 1. Код ПК -->
                                        <DataGridTextColumn Header="Код ПК" Binding="{Binding CompetencyCodes}" Width="80" />

                                        <!-- 2. Наименования разделов -->
                                        <DataGridTextColumn Header="Наименования разделов профессионального модуля" Binding="{Binding ModuleName}" Width="*" MinWidth="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="TextAlignment" Value="Left"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- 3. Всего -->
                                        <DataGridTextColumn Header="Всего, час." Binding="{Binding TotalHours}" Width="60" />

                                        <!-- 4. Практ. подготовка -->
                                        <DataGridTextColumn Header="в т.ч. в форме практической подготовки" Binding="{Binding PracticalPrepHours}" Width="75">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="в т.ч. в форме практичес-кой подго-товки" TextWrapping="Wrap" TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>

                                        <!-- 5. Обучение по МДК -->
                                        <DataGridTextColumn Header="Обучение по МДК, в т.ч.:" Binding="{Binding MdkHours}" Width="75">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="Обучение по МДК, в т.ч.:" TextWrapping="Wrap" TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>

                                        <!-- 6. Учебные занятия -->
                                        <DataGridTextColumn Header="учебные занятия" Binding="{Binding TrainingSessionsHours}" Width="70">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="учебные занятия" TextWrapping="Wrap" TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>

                                        <!-- 7. Курсовая работа -->
                                        <DataGridTextColumn Header="курсовая работа (проект)" Binding="{Binding CourseworkHours}" Width="75">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="курсовая работа (проект)" TextWrapping="Wrap" TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>

                                        <!-- 8. Самостоятельная работа -->
                                        <DataGridTextColumn Header="самостоятельная работа" Binding="{Binding IndependentWorkHours}" Width="75">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="самостоя-тельная работа" TextWrapping="Wrap" TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>

                                        <!-- 9. Учебная практика -->
                                        <DataGridTextColumn Header="Учебная практика" Binding="{Binding EducationalPracticeHours}" Width="75">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="Учебная практика" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>

                                        <!-- 10. Производственная практика -->
                                        <DataGridTextColumn Header="Производственная практика" Binding="{Binding IndustrialPracticeHours}" Width="75">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="Производ-ственная практика" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>

                                        <!-- 11. Промежуточная аттестация -->
                                        <DataGridTextColumn Header="Промежуточная аттестация" Binding="{Binding AssessmentHours}" Width="75">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="Промежу-точная аттестация" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                            

                                <Expander IsExpanded="True" x:Name="exDiscip21">
                                    <Expander.Header>
                                        <TextBlock FontWeight="Bold" FontSize="16" Text="2.1 Объем учебной дисциплины и виды учебной работы"/>
                                    </Expander.Header>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Вид учебной работы" FontSize="14" FontWeight="Bold" Margin="5"/>
                                            <TextBlock Grid.Column="1" Text="Объем в часах" FontSize="14" FontWeight="Bold" Margin="5"/>
                                            <TextBlock Grid.Column="2" Text="В т.ч. в форме практической подготовки" FontSize="14" FontWeight="Bold" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Объем рабочей программы дисциплины" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbChasRabProg1" Text="{Binding ChasRabProg1}" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="2" x:Name="tbChasRabProg2" Text="{Binding ChasRabProg2}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Основное содержание" FontWeight="Bold" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbChasOsnov" Text="{Binding ChasOsnov}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <TextBlock Grid.Column="0" Text="в том числе:" FontWeight="Bold" FontSize="14" Margin="5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="теоретическое обучение" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbTeaorChasOsnov" Text="{Binding TeaorChasOsnov}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="практические занятия" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbPractChas1" Text="{Binding PractChas1}" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="2" x:Name="tbPractChas2" Text="{Binding PractChas2}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="курсовая работа/проект" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbKursachChas" Text="{Binding KursachChas}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Самостоятельная работа" FontSize="14" FontWeight="Bold" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbSamRabChas" Text="{Binding SamRabChas}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <TextBlock Grid.Column="0" Text="Промежуточная аттестация" FontSize="14" FontWeight="Bold" Margin="5"/>
                                        <TextBlock Grid.Column="0" Text="в том числе:" FontSize="14" FontWeight="Bold" Margin="5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="1" x:Name="tbAttestation" Text="{Binding Attestation}" FontSize="14" Margin="5" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                     

                            <Expander IsExpanded="True" x:Name="exPlan" Margin="0,10,0,0">
                                <Expander.Header>
                                    <TextBlock Text="2.2 Тематический план и содержание" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                </Expander.Header>
                                <StackPanel>
                                    <DataGrid x:Name="dgPlan" ItemsSource="{Binding Themes}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
GridLinesVisibility="All" RowHeaderWidth="0" VerticalContentAlignment="Stretch" Background="White" IsReadOnly="True" MinHeight="400">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Наименование разделов и тем" Width="250" Binding="{Binding ThemeName}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Margin" Value="5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="14"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="Содержание учебного материала" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl>
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <ItemsControl ItemsSource="{Binding ContentBlocks}" BorderBrush="LightGray" BorderThickness="0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="5,2" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Hours}" Grid.Column="1" Margin="5,2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,0"/>
                                                                            <Border Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,0,0,0" VerticalAlignment="Bottom"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ContentControl>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Всего часов" Width="80" Binding="{Binding TotalHours}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="Компетенции" Width="120" Binding="{Binding Competences}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="TextAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка 4: Раздел 3 -->
                <TabItem Header="Раздел 3. Условия">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="White">
                        <StackPanel>
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock FontSize="16" Text="3.1 Требования к минимальному материально-техническому обеспечению" FontWeight="Bold"/>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBox x:Name="tbTrebKab" Text="{Binding TrebKab, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,5,0,15" IsReadOnly="True"/>
                                </StackPanel>
                            </Expander>
                            <Expander IsExpanded="True" Margin="0,10,0,0">
                                <Expander.Header>
                                    <TextBlock Text="3.2 Информационное обеспечение (Литература и ПО)" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                </Expander.Header>
                                <StackPanel>
                                    <TabControl>
                                        <TabItem Header="Основная литература">
                                            <DataGrid x:Name="dgOsnovLibrary" ItemsSource="{Binding OsnovLibrary}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Библиотечная запись" Width="*" Binding="{Binding Record}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>

                                        <TabItem Header="Дополнительная литература">
                                            <DataGrid x:Name="dgDopLibrary" ItemsSource="{Binding DopLibrary}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Библиотечная запись" Width="*" Binding="{Binding Record}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>

                                        <TabItem Header="Программное обеспечение">
                                            <DataGrid x:Name="dgPO" ItemsSource="{Binding Softwares}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Наименование ПО" Width="*" Binding="{Binding Name}"/>
                                                    <DataGridTextColumn Header="Тип лицензии" Width="*" Binding="{Binding LicenseType}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Раздел 4. Контроль и оценка">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="White">
                        <StackPanel>
                            <TextBlock Text="4 КОНТРОЛЬ И ОЦЕНКА РЕЗУЛЬТАТОВ ОСВОЕНИЯ УЧЕБНОЙ ДИСЦИПЛИНЫ"
                             FontSize="16" FontWeight="Bold" Margin="0,0,0,15" TextWrapping="Wrap"/>

                            <DataGrid x:Name="dgEvaluations" ItemsSource="{Binding Evaluations}"
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                            GridLinesVisibility="All" RowHeaderWidth="0" VerticalContentAlignment="Stretch"
                            Background="White" MinHeight="400" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Результаты обучения" Width="250" Binding="{Binding LearningOutcome}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Показатели освоенности компетенций" Width="*" Binding="{Binding Indicators}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Методы оценки" Width="120" Binding="{Binding AssessmentMethod}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ПАНЕЛЬ КНОПОК ВНИЗУ -->
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3">
            <StackPanel>

                <Button MaxWidth="250" Margin="10" Click="Button_Click" MaxHeight="50">
                    <Button.Content>
                        <TextBlock Text="Добавить РП дисциплины" TextWrapping="Wrap"/>
                    </Button.Content>
                </Button>
                <Button Margin="10" Click="Button_Click" MaxWidth="250" MaxHeight="50">
                    <Button.Content>
                        <TextBlock Text="Редактировать выбранную РП дисциплины" TextWrapping="Wrap"/>
                    </Button.Content>
                </Button>
            </StackPanel>
            <StackPanel>
                <Button MaxWidth="250" Margin="10" Click="Button_Click" MaxHeight="50">
                    <Button.Content>
                        <TextBlock Text="Добавить РП модуля" TextWrapping="Wrap"/>
                    </Button.Content>
                </Button>

                <Button Margin="10" Click="Button_Click" MaxWidth="250" MaxHeight="50">
                    <Button.Content>
                        <TextBlock Text="Редактировать выбранную РП модуля" TextWrapping="Wrap"/>
                    </Button.Content>
                </Button>
            </StackPanel>
            <Button Content="Импорт" MaxHeight="50" Margin="10" Click="BtnImportRp_Click"/>
            <Button Content="Экспорт в Word" MaxHeight="50" Margin="10" Click="BtnExportWord_Click"/>
        </StackPanel>
    </Grid>
</Page>