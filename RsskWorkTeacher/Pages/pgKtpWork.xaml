<Page x:Class="RsskWorkTeacher.Pages.pgKtpWork"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RsskWorkTeacher.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
           FontSize="17">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ComboBox Margin="10" x:Name="cbCik" MaxHeight="50" SelectionChanged="cbCik_SelectionChanged">
            
        </ComboBox>
        <ComboBox Margin="10" Grid.Row="1" x:Name="cbPlan" MaxHeight="50" SelectionChanged="cbPlan_SelectionChanged">
           
        </ComboBox>
        <ListBox Margin="10" x:Name="lbSpisokKTP" SelectionMode="Extended" Grid.RowSpan="2" Grid.Row="2" 
          SelectionChanged="lbSpisokRp_SelectionChanged"/>

        <Grid Margin="10" Grid.Column="1" Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Параметры КТП" Grid.Row="0" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Группы:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cbGroups" SelectedItem="{Binding Groups, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="5"/>

                    <TextBlock Text="Преподаватели:" Grid.Column="2" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cbTeachers" SelectedItem="{Binding Teachers, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" Margin="5"/>

                    <TextBlock Text="Учебный период:" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Period, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="5"/>

                    <TextBlock Text="Форма аттестации:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AssessmentForm, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Margin="5"/>
                </Grid>
            </GroupBox>

           

            <DataGrid x:Name="dgKtp" Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" 
      CanUserAddRows="False" GridLinesVisibility="All" Background="White"
   >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ занятия" Binding="{Binding LessonNums}" Width="auto"/>
                    <DataGridTextColumn Header="Наименование разделов и тем" Binding="{Binding ThemeName}" Width="auto"/>
                    <DataGridTextColumn Header="Кол-во часов" Binding="{Binding Hours}" Width="auto"/>
                    <DataGridTextColumn Header="Календарные сроки" Binding="{Binding Dates}" Width="auto"/>
                    <DataGridTextColumn Header="Вид занятия" Binding="{Binding Type}" Width="auto"/>
                    <DataGridTextColumn Header="Наглядные пособия и тех. средства" Binding="{Binding Aids}" Width="auto"/>
                    <DataGridTextColumn Header="Задания для студентов" Binding="{Binding Tasks}" Width="auto"/>
                </DataGrid.Columns>
            </DataGrid>

            
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="3">
          
            <Button Content="Редактировать КТП" Margin="10" Click="OpenWindowAddChange"/>
        </StackPanel>
    </Grid>
</Page>