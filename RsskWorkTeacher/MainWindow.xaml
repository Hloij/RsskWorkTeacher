<Window x:Class="RsskWorkTeacher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RsskWorkTeacher"
        mc:Ignorable="d"
        Title="MainWindow"  Height="600" FontSize="20" Width="800" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Button x:Name="btnProf" IsEnabled="False" Content="Профиль" Margin="10" Click="Button_Click"/>
            <Button x:Name="btnRp" IsEnabled="False" Content="Работа с РП" Margin="10" Click="Button_Click"/>
            <Button x:Name="btnKtp" IsEnabled="False" Content="Работа с КТП" Margin="10" Click="Button_Click"/>
          
        </StackPanel>
        <Frame x:Name="frMain" Grid.Column="1"/>
    </Grid>
</Window>
