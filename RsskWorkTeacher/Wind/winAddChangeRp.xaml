<Window x:Class="RsskWorkTeacher.Wind.winAddChangeRp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RsskWorkTeacher.Wind"
        Title="Редактор учебной документации (Полное редактирование)" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="1" Background="#E5E5E5">
            <ToolBar>
                <Button Content="💾 Сохранить" Padding="5,2" Click="ButtonSave_Click"/>
                <Separator/>
                <ComboBox Width="250" SelectedIndex="0" ToolTip="Выбор типа документа" SelectionChanged="ComboBox_SelectionChanged">
                    <ComboBoxItem Content="Шаблон рабочей программы"/>
                    <ComboBoxItem x:Name="cbiRPonWork" Content="Текущая рабочая программа" />
                </ComboBox>
                <Separator/>
                <Button Content="Экспорт в PDF" Padding="5,2" Click="BtnExportPdf_Click"/>
                <Button Content="Импорт информации из ПООП (.docx)" Click="BtnImportPopp_Click" Padding="5,2"/>
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="2" Margin="5">

                <!-- Вкладка 1: Титульный лист и Утверждение -->
                <TabItem Header="Титульный лист">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="#FAFAFA">
                        <StackPanel>
                            <TextBlock x:Name="tbTitle" Text="{Binding Title}"
                                       FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"></TextBlock>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!-- ИСПРАВЛЕНО: имя свойства приводим к тому, что есть в VM -->
                                <TextBlock x:Name="tbdicipKod"
                                           Text="{Binding DisciplineKod}"
                                           FontSize="16" FontWeight="Bold" Margin="20"
                                           HorizontalAlignment="Center" />

                                <!-- ИСПРАВЛЕНО: SelectedValue вместо Text, убран SelectedIndex -->
                                <ComboBox SelectionChanged="tbdicip_SelectionChanged"
                                          x:Name="tbdicip"
                                          Grid.Column="1"
                                          FontSize="16" FontWeight="Bold"
                                          Margin="20"
                                          HorizontalAlignment="Center"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding DisciplineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Специальность:" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="tbSpecial" Grid.Column="1" Text="{Binding Specialty}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Квалификация:" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="tbKvalificac" Grid.Column="1" Text="{Binding Qualification}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Форма обучения:" FontWeight="Bold" TextWrapping="Wrap"/>
                                <ComboBox x:Name="cbFormObuch" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding EducationForm}">
                                    <ComboBoxItem Content="очная"/>
                                    <ComboBoxItem Content="заочная"/>
                                </ComboBox>
                            </Grid>

                            <GroupBox Header="Сведения об утверждении" Margin="0,20,0,0">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Протокол №:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                                    <TextBox x:Name="tbProtocolNumber" Text="{Binding ProtocolNumber, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                                    <TextBlock Text="Дата:" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                                    <DatePicker x:Name="tbProtocolDate" SelectedDate="{Binding ProtocolDate}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                                    <TextBlock Text="Председатель:" Grid.Row="2" Grid.Column="0" Margin="0,5"/>
                                    <TextBox x:Name="tbProtocolPredsedatel" Text="{Binding ProtocolPredsedatel, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Утверждено на методическом совете" Margin="0,20,0,0">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Протокол №:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                                    <TextBox x:Name="tbProtocolSovetNumber" Text="{Binding ProtocolSovetNumber, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                                    <TextBlock Text="Дата:" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                                    <DatePicker x:Name="tbProtocolSovetDate" SelectedDate="{Binding ProtocolSovetDate}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
                                </Grid>
                            </GroupBox>

                            <DataGrid x:Name="dgRazrabs" ItemsSource="{Binding Developers}" AutoGenerateColumns="False" Margin="0,20,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО разработчика" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка 2: Раздел 1 -->
                <TabItem Header="Раздел 1. Общая характеристика">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="White">
                        <StackPanel>
                            <TextBlock Text="1.1 Цель и место учебной дисциплины" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Цель дисциплины:" FontWeight="Bold"/>
                            <TextBox x:Name="tbPurpose" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,5,0,15"/>
                            <TextBlock x:Name="tbCompetencies" Text="{Binding CompetenciesLabel}" />

                            <TextBlock Text="1.2 Планируемые результаты освоения дисциплины" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                            <TextBlock Text="В результате освоения дисциплины обучающийся должен:" Margin="0,0,0,5"/>

                            <DataGrid x:Name="dgCompetencies" ItemsSource="{Binding Competencies}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="250" Margin="0,5" EnableRowVirtualization="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Код ОК, ПК" Width="100" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Уметь" Width="*" Binding="{Binding KnowHow, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Знать" Width="*" Binding="{Binding Knowledge, UpdateSourceTrigger=PropertyChanged}"/>
                                 
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка 3: Раздел 2 -->
                <TabItem Header="Раздел 2. Структура и содержание">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="White">


                       

                            <StackPanel Grid.Row="0"  Orientation="Vertical" Margin="0,0,0,10">
                                <Expander x:Name="exDiscip21"  >
                                    <Expander.Header>
                                        <TextBlock FontWeight="Bold" FontSize="16" Text="2.1 Объем учебной дисциплины и виды учебной работы"/>
                                    </Expander.Header>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Вид учебной работы" FontSize="14" FontWeight="Bold" Margin="5"/>
                                            <TextBlock Grid.Column="1" Text="Объем в часах" FontSize="14" FontWeight="Bold" Margin="5"/>
                                            <TextBlock Grid.Column="2" Text="В т.ч. в форме практической подготовки" FontSize="14" FontWeight="Bold" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Объем рабочей программы дисциплины" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbChasRabProg1" Text="{Binding ChasRabProg1}" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="2" x:Name="tbChasRabProg2" Text="{Binding ChasRabProg2}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Основное содержание" FontWeight="Bold" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbChasOsnov" Text="{Binding ChasOsnov}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <TextBlock Grid.Column="0" Text="в том числе:" FontWeight="Bold" FontSize="14" Margin="5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="теоретическое обучение" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbTeaorChasOsnov" Text="{Binding TeaorChasOsnov}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="практические занятия" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbPractChas1" Text="{Binding PractChas1}" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="2" x:Name="tbPractChas2" Text="{Binding PractChas2}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="курсовая работа/проект" FontSize="14" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbKursachChas" Text="{Binding KursachChas}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Самостоятельная работа" FontSize="14" FontWeight="Bold" Margin="5"/>
                                            <TextBlock Grid.Column="1" x:Name="tbSamRabChas" Text="{Binding SamRabChas}" FontSize="14" Margin="5"/>
                                        </Grid>
                                        <TextBlock Grid.Column="0" Text="Промежуточная аттестация" FontSize="14" FontWeight="Bold" Margin="5"/>
                                        <TextBlock Grid.Column="0" Text="в том числе:" FontSize="14" FontWeight="Bold" Margin="5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="1" x:Name="tbAttestation"               Text="{Binding Attestation}"               FontSize="14" Margin="5" TextWrapping="Wrap"/>
                                        </Grid>

                                    </StackPanel>
                                </Expander>
                   

                 
                            <Expander Grid.Row="1" x:Name="exDiscip22">
                                <Expander.Header>
                                    <TextBlock Text="2.2 Тематический план и содержание" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                </Expander.Header>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" >
                                        <Button Content="Добавить тему" Padding="10,5" Margin="5" Click="btnAddThem"/>
                                        <Button Content="Изменить тему" Padding="10,5" Margin="5" Click="btnChangeThem"/>
                                        <Button Content="Удалить тему" Padding="10,5" Margin="5" Click="btnDelThem"/>
                                    </StackPanel>
                                    <DataGrid x:Name="dgPlan" ItemsSource="{Binding Themes}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
          GridLinesVisibility="All" RowHeaderWidth="0" VerticalContentAlignment="Stretch" Background="White">
                                        <DataGrid.Columns>
                                            <!-- 1. Название темы / раздела -->
                                            <DataGridTextColumn Header="Наименование разделов и тем" Width="250" Binding="{Binding ThemeName}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Margin" Value="5"/>
                                                        <Style.Triggers>
                                                            <!-- Триггер для раздела -->
                                                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                                <!-- Серый фон -->
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="14"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- 2. Содержание (скрывается, если это раздел) -->
                                            <DataGridTemplateColumn Header="Содержание учебного материала" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl>
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <ItemsControl ItemsSource="{Binding ContentBlocks}" BorderBrush="LightGray" BorderThickness="0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="5,2" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Hours}" Grid.Column="1" Margin="5,2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,0"/>
                                                                            <Border Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,0,0,0" VerticalAlignment="Bottom"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ContentControl>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 3. Всего часов (скрывается, если это раздел) -->
                                            <DataGridTextColumn Header="Всего часов" Width="80" Binding="{Binding TotalHours}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- 4. Компетенции (скрывается, если это раздел) -->
                                            <DataGridTextColumn Header="Компетенции" Width="120" Binding="{Binding Competences}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="TextAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>
                            </StackPanel>
                      
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка 4: Раздел 3 -->
                <TabItem Header="Раздел 3. Условия">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Expander>
                            <Expander.Header>
                                <TextBlock FontSize="16" Text="3.1 Требования к минимальному материально-техническому обеспечению" FontWeight="Bold"/>
                            </Expander.Header>
                            <StackPanel>
                                <TextBox x:Name="tbTrebKab" Text="{Binding TrebKab, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,5,0,15"/>
                            </StackPanel>
                        </Expander>
                        <Expander Grid.Row="2">
                            <Expander.Header>
                                <TextBlock Grid.Row="1" Text="3.2 Информационное обеспечение (Литература и ПО)" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            </Expander.Header>
                            <StackPanel>
                                <TabControl>
                                    <TabItem Header="Основная литература">
                                        <DataGrid x:Name="dgOsnovLibrary" ItemsSource="{Binding OsnovLibrary}" AutoGenerateColumns="False" CanUserAddRows="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Библиотечная запись" Width="*" Binding="{Binding Record}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                    <TabItem Header="Дополнительная литература">
                                        <DataGrid x:Name="dgDopLibrary" ItemsSource="{Binding DopLibrary}" AutoGenerateColumns="False" CanUserAddRows="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Библиотечная запись" Width="*" Binding="{Binding Record}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                    <TabItem Header="Программное обеспечение">
                                        <DataGrid x:Name="dgPO" ItemsSource="{Binding Softwares}" AutoGenerateColumns="False" CanUserAddRows="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Наименование ПО" Width="*" Binding="{Binding Name}"/>
                                                <DataGridTextColumn Header="Тип лицензии" Width="*" Binding="{Binding LicenseType}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </TabItem>

                <TabItem Header="Раздел 4. Контроль и оценка">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="White">
                        <StackPanel>
                            <TextBlock Text="4 КОНТРОЛЬ И ОЦЕНКА РЕЗУЛЬТАТОВ ОСВОЕНИЯ УЧЕБНОЙ ДИСЦИПЛИНЫ"
                                       FontSize="16" FontWeight="Bold" Margin="0,0,0,15" TextWrapping="Wrap"/>

                            <DataGrid x:Name="dgEvaluations" ItemsSource="{Binding Evaluations}"
                                      AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                      GridLinesVisibility="All" RowHeaderWidth="0" VerticalContentAlignment="Stretch"
                                      Background="White" MinHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Результаты обучения" Width="250" Binding="{Binding LearningOutcome}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Показатели освоенности компетенций" Width="*" Binding="{Binding Indicators}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Методы оценки" Width="120" Binding="{Binding AssessmentMethod}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <StatusBar Grid.Row="3" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="Режим: Полное редактирование"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>